<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Notifications | TravelWithMe</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
    }

    .notifications-container {
      max-width: 900px;
      margin: 40px auto;
      padding: 0;
      background: none;
      box-shadow: none;
    }

    .notifications-header {
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: white;
      padding: 40px;
      border-radius: 20px 20px 0 0;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .notifications-header::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: repeating-linear-gradient(
        45deg,
        transparent,
        transparent 2px,
        rgba(255,255,255,0.05) 2px,
        rgba(255,255,255,0.05) 4px
      );
      animation: shimmer 15s linear infinite;
    }

    @keyframes shimmer {
      0% { transform: translateX(-100px) translateY(-100px); }
      100% { transform: translateX(100px) translateY(100px); }
    }

    .notifications-header h1 {
      font-size: 2.5rem;
      margin-bottom: 10px;
      color: white;
      background: none;
      -webkit-text-fill-color: white;
      position: relative;
      z-index: 2;
    }

    .back-link {
      position: absolute;
      top: 20px;
      left: 20px;
      color: white;
      text-decoration: none;
      font-weight: 500;
      padding: 8px 16px;
      border-radius: 20px;
      background: rgba(255,255,255,0.2);
      backdrop-filter: blur(10px);
      transition: all 0.3s ease;
      z-index: 3;
    }

    .back-link:hover {
      background: rgba(255,255,255,0.3);
      transform: translateY(-2px);
    }

    .notifications-content {
      background: white;
      border-radius: 0 0 20px 20px;
      padding: 40px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.1);
      min-height: 400px;
    }

    .notification-card {
      background: white;
      border-radius: 15px;
      padding: 24px;
      margin-bottom: 20px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.08);
      border-left: 5px solid var(--primary-blue);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .notification-card.unread {
      border-left-color: var(--accent-orange);
      background: linear-gradient(135deg, #fff8f4, #ffffff);
    }

    .notification-card.unread::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent-orange), var(--warning-yellow));
    }

    .notification-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    }

    .notification-header {
      display: flex;
      justify-content: between;
      align-items: flex-start;
      margin-bottom: 15px;
      gap: 15px;
    }

    .notification-badge {
      background: var(--accent-orange);
      color: white;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      animation: pulse 2s infinite;
    }

    .notification-message {
      font-size: 1.1rem;
      color: var(--text-primary);
      line-height: 1.6;
      margin-bottom: 15px;
    }

    .notification-timestamp {
      font-size: 0.9rem;
      color: var(--text-secondary);
      margin-bottom: 15px;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .notification-actions {
      display: flex;
      gap: 10px;
      align-items: center;
      justify-content: flex-end;
    }

    .mark-read-btn {
      background: linear-gradient(135deg, var(--success-green), #20c997);
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .mark-read-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
    }

    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: var(--text-secondary);
    }

    .empty-state-icon {
      font-size: 4rem;
      margin-bottom: 20px;
      opacity: 0.5;
    }

    .empty-state h3 {
      font-size: 1.5rem;
      color: var(--text-primary);
      margin-bottom: 10px;
    }

    .empty-state p {
      font-size: 1.1rem;
      color: var(--text-secondary);
    }

    .notification-summary {
      background: linear-gradient(135deg, #f8f9ff, #e6f3ff);
      border-radius: 15px;
      padding: 20px;
      margin-bottom: 30px;
      text-align: center;
      position: relative;
      z-index: 2;
    }

    .summary-text {
      font-size: 1.1rem;
      color: var(--text-primary);
      margin: 0;
    }

    @media (max-width: 768px) {
      .notifications-header {
        padding: 30px 20px;
      }

      .notifications-content {
        padding: 25px 20px;
      }

      .notification-card {
        padding: 20px;
      }

      .notification-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
      }

      .notification-actions {
        justify-content: flex-start;
      }

      .back-link {
        position: static;
        display: inline-block;
        margin-bottom: 20px;
      }
    }
  </style>
</head>
<body>
  <div class="notifications-container">
    <div class="notifications-header">
      <a href="/dashboard" class="back-link">← Back to Dashboard</a>
      <h1>🔔 Notifications</h1>
    </div>

    <div class="notifications-content">
      <% if (notifications.length > 0) { %>
        <div class="notification-summary">
          <p class="summary-text">
            You have <%= notifications.length %> notification<%= notifications.length !== 1 ? 's' : '' %>
            <% const unreadCount = notifications.filter(n => !n.isRead).length; %>
            <% if (unreadCount > 0) { %>
              (<%= unreadCount %> unread)
            <% } %>
          </p>
        </div>
      <% } %>

      <% if (notifications.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon">🔕</div>
          <h3>No notifications yet</h3>
          <p>When you have travel group updates, they'll appear here!</p>
        </div>
      <% } else { %>
        <% notifications.forEach(note => { %>
          <div class="notification-card <%= !note.isRead ? 'unread' : '' %>">
            <div class="notification-header">
              <% if (!note.isRead) { %>
                <span class="notification-badge">✨ New</span>
              <% } %>
            </div>
            
            <div class="notification-message">
              <%= note.message %>
            </div>
            
            <div class="notification-timestamp">
              🕒 <%= note.timestamp.toLocaleString() %>
            </div>
            
            <% if (!note.isRead) { %>
              <div class="notification-actions">
                <form method="POST" action="/notifications/read/<%= note._id %>" style="display: inline;">
                  <button type="submit" class="mark-read-btn">
                    ✓ Mark as Read
                  </button>
                </form>
              </div>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</body>
</html>
