<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Recommendations | <%= group.destination %></title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      margin: 0;
      font-family: 'Inter', 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
    }

    .recommendations-container {
      max-width: 100vw;
      height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .recommendations-header {
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: white;
      padding: 20px 30px;
      position: relative;
      z-index: 1000;
      box-shadow: 0 4px 16px rgba(0,0,0,0.2);
    }

    .recommendations-header h2 {
      margin: 0;
      font-size: 2rem;
      color: white;
      background: none;
      -webkit-text-fill-color: white;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .header-controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
      margin-top: 15px;
    }

    .filter-controls {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .filter-btn {
      background: rgba(255,255,255,0.2);
      color: white;
      border: 2px solid rgba(255,255,255,0.3);
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s ease;
      backdrop-filter: blur(10px);
    }

    .filter-btn:hover, .filter-btn.active {
      background: rgba(255,255,255,0.3);
      border-color: rgba(255,255,255,0.5);
      transform: translateY(-2px);
    }

    .back-link {
      background: rgba(255,255,255,0.2);
      color: white;
      text-decoration: none;
      padding: 8px 16px;
      border-radius: 20px;
      font-weight: 500;
      transition: all 0.3s ease;
      backdrop-filter: blur(10px);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .back-link:hover {
      background: rgba(255,255,255,0.3);
      transform: translateY(-2px);
    }

    .map-container {
      flex: 1;
      position: relative;
      margin: 0;
      border-radius: 20px 20px 0 0;
      overflow: hidden;
      box-shadow: 0 -4px 16px rgba(0,0,0,0.1);
    }

    #map {
      height: 100%;
      width: 100%;
      z-index: 1;
    }

    .map-legend {
      position: absolute;
      bottom: 20px;
      left: 20px;
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(10px);
      padding: 15px;
      border-radius: 15px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.2);
      z-index: 1000;
      max-width: 250px;
    }

    .legend-title {
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 10px;
      font-size: 1rem;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
      font-size: 0.9rem;
      color: var(--text-secondary);
    }

    .legend-icon {
      font-size: 1.2rem;
      width: 20px;
      text-align: center;
    }

    .loading-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(255,255,255,0.9);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 2000;
      backdrop-filter: blur(5px);
    }

    .loading-spinner {
      width: 50px;
      height: 50px;
      border: 4px solid var(--primary-blue-light);
      border-top: 4px solid var(--primary-blue);
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .error-message {
      background: var(--danger-red);
      color: white;
      padding: 10px 15px;
      border-radius: 10px;
      margin: 10px;
      font-size: 0.9rem;
      display: none;
    }

    @media (max-width: 768px) {
      .recommendations-header {
        padding: 15px 20px;
      }

      .recommendations-header h2 {
        font-size: 1.5rem;
      }

      .header-controls {
        flex-direction: column;
        align-items: stretch;
      }

      .filter-controls {
        justify-content: center;
      }

      .map-legend {
        bottom: 10px;
        left: 10px;
        right: 10px;
        max-width: none;
      }
    }

    /* Custom Leaflet popup styling */
    .leaflet-popup-content-wrapper {
      background: white;
      border-radius: 12px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.2);
    }

    .leaflet-popup-content {
      margin: 15px;
      font-family: 'Inter', sans-serif;
    }

    .leaflet-popup-tip {
      background: white;
    }
  </style>
</head>
<body>
  <div class="recommendations-container">
    <div class="recommendations-header">
      <h2>📍 Discover <%= group.destination %></h2>
      <div class="header-controls">
        <div class="filter-controls">
          <button class="filter-btn active" onclick="togglePOI('restaurant', this)">🍽️ Restaurants</button>
          <button class="filter-btn active" onclick="togglePOI('hotel', this)">🏨 Hotels</button>
          <button class="filter-btn active" onclick="togglePOI('taxi', this)">🚕 Transport</button>
          <button class="filter-btn active" onclick="togglePOI('attraction', this)">🎯 Attractions</button>
        </div>
        <a href="/dashboard" class="back-link">← Back to Dashboard</a>
      </div>
    </div>

    <div class="map-container">
      <div id="map"></div>
      
      <div class="map-legend">
        <div class="legend-title">📋 Map Legend</div>
        <div class="legend-item">
          <span class="legend-icon">🍽️</span>
          <span>Restaurants & Dining</span>
        </div>
        <div class="legend-item">
          <span class="legend-icon">🏨</span>
          <span>Hotels & Accommodation</span>
        </div>
        <div class="legend-item">
          <span class="legend-icon">🚕</span>
          <span>Transportation</span>
        </div>
        <div class="legend-item">
          <span class="legend-icon">🎯</span>
          <span>Tourist Attractions</span>
        </div>
      </div>

      <div class="loading-overlay" id="loading">
        <div class="loading-spinner"></div>
      </div>
    </div>

    <div class="error-message" id="errorMessage"></div>
  </div>

  <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
  <script>
    const map = L.map('map').setView([<%= lat %>, <%= lon %>], 14);
    const markers = {
      restaurant: [],
      hotel: [],
      taxi: [],
      attraction: []
    };

    // Add beautiful tile layer
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 19
    }).addTo(map);

    // Add center marker for the destination
    L.marker([<%= lat %>, <%= lon %>], {
      icon: L.divIcon({
        className: 'custom-div-icon',
        html: '<div style="background: #ff6b35; color: white; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; box-shadow: 0 2px 8px rgba(0,0,0,0.3);">📍</div>',
        iconSize: [30, 30],
        iconAnchor: [15, 15]
      })
    }).addTo(map).bindPopup(`<strong>📍 <%= group.destination %></strong><br>Your destination`);

    async function fetchPOIs(query, icon, label, category) {
      const overpassUrl = "https://overpass-api.de/api/interpreter";
      const lat = <%= lat %>;
      const lon = <%= lon %>;
      const delta = 0.02;
      const bbox = `${lat - delta},${lon - delta},${lat + delta},${lon + delta}`;

      const queryBody = `
        [out:json][timeout:25];
        (
          node[${query}](${bbox});
          way[${query}](${bbox});
          relation[${query}](${bbox});
        );
        out center;
      `.trim();

      try {
        const res = await fetch(overpassUrl, {
          method: "POST",
          body: queryBody,
          headers: { "Content-Type": "application/x-www-form-urlencoded" }
        });

        const data = await res.json();

        data.elements.forEach(el => {
          const lat = el.lat || el.center?.lat;
          const lon = el.lon || el.center?.lon;
          const name = el.tags?.name || label;

          if (lat && lon) {
            const marker = L.marker([lat, lon])
              .bindPopup(`<strong>${icon} ${name}</strong><br>${label}`);
            
            markers[category].push(marker);
            marker.addTo(map);
          }
        });

      } catch (err) {
        console.error(`❌ Failed to fetch ${label}:`, err);
        showError(`Failed to load ${label} data`);
      }
    }

    function togglePOI(category, button) {
      button.classList.toggle('active');
      const isActive = button.classList.contains('active');
      
      markers[category].forEach(marker => {
        if (isActive) {
          marker.addTo(map);
        } else {
          map.removeLayer(marker);
        }
      });
    }

    function showError(message) {
      const errorEl = document.getElementById('errorMessage');
      errorEl.textContent = message;
      errorEl.style.display = 'block';
      setTimeout(() => {
        errorEl.style.display = 'none';
      }, 5000);
    }

    function hideLoading() {
      document.getElementById('loading').style.display = 'none';
    }

    // Load all POI data
    async function loadAllPOIs() {
      try {
        await Promise.all([
          fetchPOIs('"amenity"="restaurant"', '🍽️', 'Restaurant', 'restaurant'),
          fetchPOIs('"tourism"="hotel"', '🏨', 'Hotel', 'hotel'),
          fetchPOIs('"amenity"="taxi"', '🚕', 'Taxi Stand', 'taxi'),
          fetchPOIs('"tourism"="attraction"', '🎯', 'Tourist Attraction', 'attraction')
        ]);
      } catch (error) {
        showError('Failed to load some location data');
      } finally {
        hideLoading();
      }
    }

    // Start loading data
    loadAllPOIs();

    // Add map controls
    map.on('zoomend', function() {
      if (map.getZoom() > 16) {
        map.setZoom(16);
      }
    });
  </script>
</body>
</html>
