<!DOCTYPE html>
<html>
<head>
  <title>Admin Dashboard | TravelWithMe</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background: #f0f9ff; padding: 30px; color: #333; }
    h1 { text-align: center; color: #1e3a8a; margin-bottom: 40px; }
    .section { background: #fff; border-radius: 10px; padding: 25px; margin-bottom: 40px; box-shadow: 0 4px 16px rgba(0,0,0,0.05); }
    h2 { color: #1d4ed8; border-bottom: 2px solid #e0e7ff; padding-bottom: 6px; margin-bottom: 15px; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td { padding: 10px; border-bottom: 1px solid #eee; text-align: left; }
    th { background: #f8fafc; }
    tr:hover { background: #f9f9f9; }
    .btn { padding: 6px 10px; font-size: 0.85em; border: none; border-radius: 4px; cursor: pointer; }
    .delete-btn { background: #ef4444; color: white; }
    .delete-btn:hover { background: #b91c1c; }
    .approve-btn { background: #10b981; color: white; }
    .approve-btn:hover { background: #047857; }
    .moderate { background: #facc15; }
  </style>
</head>
<body>

<h1>🌐 Admin Panel — TravelWithMe</h1>

<div class="section">
  <h2>👥 Users</h2>
  <table>
    <tr><th>Name</th><th>Email</th><th>Joined</th><th>Actions</th></tr>
    <% users.forEach(user => { %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= new Date(user._id.getTimestamp()).toLocaleDateString() %></td>
        <td>
    <form action="/admin/users/<%= user._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this user?');">
      <button class="btn delete-btn" type="submit">🗑️ Delete</button>
    </form>
  </td>
      </tr>
    <% }) %>
  </table>
</div>

<div class="section">
  <h2>🧳 Travel Groups</h2>
  <table>
    <tr><th>Name</th><th>Destination</th><th>Date</th><th>Admin</th><th>Members</th><th>Actions</th></tr>
    <% groups.forEach(group => { %>
      <tr>
        <td><%= group.name %></td>
        <td><%= group.destination %></td>
        <td><%= group.date.toDateString() %></td>
        <td><%= group.createdBy?.name %></td>
        <td><%= group.members.length %></td>
        <td>
    <form action="/admin/groups/<%= group._id %>/delete" method="POST" onsubmit="return confirm('Delete this group?');">
      <button class="btn delete-btn" type="submit">🗑️ Delete</button>
    </form>
  </td>
      </tr>
    <% }) %>
  </table>
</div>

<div class="section">
  <h2>👨‍🏫 Guides</h2>
  <table>
    <tr><th>Name</th><th>City</th><th>Available</th><th>Email</th><th>Experience</th></tr>
    <% guides.forEach(g => { %>
      <tr>
        <td><%= g.name %></td>
        <td><%= g.city %></td>
        <td><%= g.available ? "✅ Yes" : "❌ No" %></td>
        <td><%= g.email %></td>
        <td><%= g.experience %></td>
      </tr>
    <% }) %>
  </table>
</div>

<div class="section">
  <h2>📅 Guide Bookings</h2>
  <table>
    <tr><th>Guide</th><th>Group</th><th>Rating</th><th>Date</th></tr>
    <% bookings.forEach(b => { %>
      <tr>
        <td><%= b.guide.name %></td>
        <td><%= b.group.name %></td>
        <td><%= b.rating || "—" %></td>
        <td><%= new Date(b.createdAt).toLocaleString() %></td>
      </tr>
    <% }) %>
  </table>
</div>

<div class="section">
  <h2>🔔 Notifications</h2>
  <ul>
    <% notifications.forEach(n => { %>
      <li><strong><%= n.user.name %></strong>: <%= n.message %></li>
    <% }) %>
  </ul>
</div>

<div class="section">
  <h2>📝 Admin Action Logs</h2>
  <ul>
    <% logs.forEach(log => { %>
      <li>
        <strong><%= log.action === 'approve' ? '✅ Approved' : '❌ Removed' %></strong>
        <%= log.targetUser.name %> by <%= log.admin.name %>
        <% if (log.reason) { %> — Reason: "<%= log.reason %>" <% } %>
       (Group: <%= log.group ? log.group.name : "Deleted Group" %>) — <%= new Date(log.timestamp).toLocaleString() %>

      </li>
    <% }) %>
  </ul>
</div>

<div class="section">
  <h2>📊 Analytics</h2>
  <ul>
    <li><strong>Total Users:</strong> <%= users.length %></li>
    <li><strong>Active Groups:</strong> <%= groups.length %></li>
    <li><strong>Total Guide Bookings:</strong> <%= bookings.length %></li>
    <li><strong>Top Destinations:</strong> <!-- Optional chart in future --></li>
  </ul>
</div>

</body>
</html>
