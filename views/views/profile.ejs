<!DOCTYPE html>
<html>
<head>
  <title>Your Profile | TravelWithMe</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <h1>👤 Your Profile</h1>
    <a href="/dashboard">← Back to Dashboard</a>

    <h2>Profile Info</h2>
    <p><strong>Name:</strong> <%= user.name %></p>
    <p><strong>Email:</strong> <%= user.email %></p>

    <h2>Edit Your Bio & Preferences</h2>
    <form method="POST" action="/profile">
      <label>Bio:</label><br>
      <textarea name="bio" rows="3" cols="50"><%= user.bio %></textarea><br>

      <label>Interests:</label><br>
      <input name="interests" value="<%= user.interests %>"><br>

      <label>Preferred Destinations:</label><br>
      <input name="preferredDestinations" value="<%= user.preferredDestinations %>"><br>

      <button type="submit">Update Profile</button>
    </form>
  </div>
</body>
</html>
