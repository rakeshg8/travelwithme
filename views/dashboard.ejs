<!DOCTYPE html>
<html>
<head>
  <title>Dashboard | TravelWithMe</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #f0f8ff, #c2e9fb);
      
      margin: 0;
      padding: 0;
    }

   

    .container {
      max-width: 900px;
      margin: 40px auto;
      padding: 30px;
      background: rgba(255, 255, 255, 0.95);
      border-radius: 20px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
      animation: fadeIn 1s ease-in;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    header {
      text-align: center;
      margin-bottom: 30px;
    }

    header h1 {
      font-size: 3em;
      color: #0077cc;
      margin-bottom: 10px;
    }

    .nav-links a {
      margin: 0 10px;
      text-decoration: none;
      font-weight: bold;
      padding: 10px 18px;
      border-radius: 25px;
      color: #0077cc;
      background: #e6f4ff;
      transition: all 0.3s ease;
    }

    .nav-links a:hover {
      background: #0077cc;
      color: white;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    section {
      margin-bottom: 40px;
      animation: fadeIn 1.2s ease;
    }

    .create-group form {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 10px;
    }

    .create-group input, .create-group button {
      padding: 10px;
      font-size: 1em;
      border-radius: 8px;
      border: 1px solid #ccc;
    }

    .create-group button {
      background: #0077cc;
      color: white;
      cursor: pointer;
      transition: 0.3s;
      border: none;
    }

    .create-group button:hover {
      background: #005fa3;
    }

    .group-card {
      background: #e3f2fd;
      border-left: 5px solid #0077cc;
      padding: 16px;
      margin-bottom: 15px;
      border-radius: 12px;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .group-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }

    .group-card-header {
      font-size: 1.2em;
      font-weight: bold;
      color: #0077cc;
    }

    .group-meta {
      font-size: 0.95em;
      color: #333;
      margin-bottom: 10px;
    }

    .group-actions {
      display: flex;
      gap: 10px;
      margin-top: 8px;
    }

    .group-actions a, .group-actions button {
      padding: 8px 14px;
      font-size: 0.9em;
      border-radius: 6px;
      text-decoration: none;
      color: white;
      background: #0077cc;
      border: none;
      cursor: pointer;
      transition: background 0.3s ease;
    }

    .group-actions button {
      background: #e74c3c;
    }

    .group-actions button:hover {
      background: #c0392b;
    }

    .group-actions a:hover {
      background: #005fa3;
    }

  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>🌍 TravelWithMe</h1>
      <p>Welcome, <strong><%= user.name %></strong>!</p>
      <nav class="nav-links">
        <a href="/groups">🔍 Browse Groups</a>
        <a href="/profile">👤 Profile</a>
        <a href="/notifications">🔔 Notifications (<%= notifications.length %>)</a>
        <a href="/logout">🚪 Logout</a>
      </nav>
    </header>

    <section class="create-group">
     <h2>➕ Want to start a new travel group?</h2>
  <a href="/groups/create" class="nav-links" style="display: inline-block; padding: 10px 20px; background: #0077cc; color: white; border-radius: 10px; text-decoration: none;">Create Group</a>
    </section>

    <section class="my-groups">
      <h2>👥 Your Travel Groups</h2>
      <% if (groups.length === 0) { %>
        <p>You haven't joined any travel groups yet. Create one or join from the browse page!</p>
      <% } else { %>
        <% groups.forEach(group => { %>
          <div class="group-card">
            <div class="group-card-header"><%= group.name %></div>
            <div class="group-meta">
              Destination: <strong><%= group.destination %></strong><br>
              Date: <%= group.date ? group.date.toDateString() : "Not set" %>
            </div>
            <% if (group.createdBy._id.toString() === user._id.toString()) { %>
  <a href="/groups/<%= group._id %>/details">👁️ View Group Details</a>
<% } %>

            <div class="group-actions">
              <a href="/groups/<%= group._id %>/chat">💬 Chat</a>
              <% if (group.createdBy && group.createdBy.toString() === user._id.toString()) { %>
                <form action="/groups/<%= group._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this group?')">
                  <button type="submit">🗑️ Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } %>
    </section>
    
  </div>
</body>
</html>
