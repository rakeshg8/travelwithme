<!DOCTYPE html>
<html>
<head>
  <title>Create Travel Group | TravelWithMe</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background: linear-gradient(to right, #dbeafe, #f0f9ff);
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 700px;
      margin: 50px auto;
      background: white;
      padding: 30px;
      border-radius: 16px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
    }

    h2 {
      text-align: center;
      margin-bottom: 30px;
      color: #0077cc;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    input, button {
      padding: 12px;
      border-radius: 8px;
      font-size: 1em;
      border: 1px solid #ccc;
    }

    button {
      background: #0077cc;
      color: white;
      cursor: pointer;
      transition: background 0.3s ease;
    }

    button:hover {
      background: #005fa3;
    }

    .back-link {
      display: block;
      margin-top: 20px;
      text-align: center;
      color: #0077cc;
      text-decoration: none;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    datalist option {
      font-size: 1em;
    }
    .city-selector {
  position: relative;
  margin-top: 20px;
}

#citySearch {
  width: 100%;
  padding: 12px;
  font-size: 1em;
  border-radius: 8px;
  border: 1px solid #ccc;
  cursor: pointer;
  background-color: #f9f9f9;
}

.detect-btn {
  margin-top: 10px;
  border: none;
  background: none;
  color: #d32f2f;
  font-weight: bold;
  cursor: pointer;
  font-size: 0.95em;
}

.city-grid {
  display: none;
  background: #fff;
  padding: 15px;
  border-radius: 12px;
  box-shadow: 0 5px 20px rgba(0,0,0,0.1);
  margin-top: 10px;
  animation: fadeIn 0.3s ease;
}

.city-grid .label {
  font-weight: bold;
  color: #0077cc;
  margin-bottom: 10px;
}

.cities {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
  gap: 10px;
  margin-bottom: 10px;
}

.city {
  text-align: center;
  padding: 10px;
  background: #f1f9ff;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.2s;
}

.city:hover {
  background: #0077cc;
  color: white;
}

.view-all {
  display: block;
  text-align: center;
  color: #d32f2f;
  font-weight: bold;
  text-decoration: none;
}

  </style>
</head>
<body>
  <div class="container">
    <h2>➕ Create a New Travel Group</h2>
    <form method="POST" action="/groups/create">
      <input name="name" placeholder="Group Name" required>

      <h3>Select Destination</h3>

<div class="city-selector">
  <input type="text" id="citySearch" placeholder="🔍 Search for your city" oninput="filterCities()" readonly onclick="toggleCityList()" required>
  <button onclick="detectLocation()" class="detect-btn">📍 Detect my location</button>

  <div class="city-grid" id="cityGrid">
    <p class="label">Popular Cities</p>
    <div class="cities">
      <% const cities = ["Mumbai", "Delhi-NCR", "Bengaluru", "Hyderabad", "Ahmedabad", "Chandigarh", "Chennai", "Pune", "Kolkata", "Kochi"]; %>
      <% cities.forEach(city => { %>
        <div class="city" onclick="selectCity('<%= city %>')"><%= city %></div>
      <% }) %>
    </div>
    <a href="#" class="view-all">View All Cities</a>
  </div>
</div>

<input type="hidden" name="destination" id="selectedCity" required>


      <input type="date" name="date" required>

      <button type="submit">Create Group</button>
    </form>

    <a class="back-link" href="/dashboard">← Back to Dashboard</a>
  </div>
<script>
  function toggleCityList() {
    document.getElementById("cityGrid").style.display = "block";
  }

  function selectCity(city) {
    document.getElementById("citySearch").value = city;
    document.getElementById("selectedCity").value = city;
    document.getElementById("cityGrid").style.display = "none";
  }

  function filterCities() {
    const input = document.getElementById("citySearch").value.toLowerCase();
    const cities = document.querySelectorAll(".city");

    cities.forEach(c => {
      if (c.innerText.toLowerCase().includes(input)) {
        c.style.display = "";
      } else {
        c.style.display = "none";
      }
    });
  }

  function detectLocation() {
    if (!navigator.geolocation) {
      alert("Geolocation not supported");
      return;
    }

    navigator.geolocation.getCurrentPosition(async pos => {
      const lat = pos.coords.latitude;
      const lon = pos.coords.longitude;

      // Use OpenCage API or any geolocation API here
      const res = await fetch(`https://api.opencagedata.com/geocode/v1/json?q=${lat}+${lon}&key=819c431f8dbc44f39fa315ad2ba6ce45`);
      const data = await res.json();
      const city = data.results[0]?.components.city || data.results[0]?.components.town || data.results[0]?.components.state;

      if (city) {
        selectCity(city);
      } else {
        alert("City not detected");
      }
    });
  }
</script>

</body>
</html>
